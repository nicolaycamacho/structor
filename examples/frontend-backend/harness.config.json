{
  "$schema": "../../schemas/harness-config.schema.json",
  "project": {
    "name": "Example Platform",
    "slug": "example-platform",
    "harnessRepoName": "example-platform-structor"
  },
  "output": {
    "path": "../../../generated/example-platform-structor"
  },
  "models": {
    "openai": true,
    "anthropic": true
  },
  "consumers": [
    {
      "name": "example-frontend",
      "path": "./example-frontend",
      "purpose": "Frontend application repository",
      "validation": {
        "lint": "npm run lint",
        "build": "npm run build"
      }
    },
    {
      "name": "example-api",
      "path": "./example-api",
      "purpose": "Backend API repository",
      "validation": {
        "lint": "npm run lint",
        "test": "npm test"
      }
    }
  ]
}
