{
  "$schema": "../../schemas/harness-config.schema.json",
  "profile": "focused",
  "project": {
    "name": "Example Worker",
    "slug": "example-worker",
    "harnessRepoName": "example-worker-structor"
  },
  "output": {
    "path": "../../../generated/example-worker-structor"
  },
  "models": {
    "openai": true,
    "anthropic": true
  },
  "consumers": [
    {
      "name": "example-worker",
      "path": "./example-worker",
      "purpose": "Worker repository used by both OpenAI and Anthropic agents",
      "validation": {
        "install": "npm install",
        "lint": "npm run lint",
        "test": "npm test",
        "build": "npm run build"
      }
    }
  ]
}
