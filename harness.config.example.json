{
  "$schema": "./schemas/harness-config.schema.json",
  "project": {
    "name": "Example Project",
    "slug": "example-project",
    "harnessRepoName": "example-structor"
  },
  "output": {
    "path": "../example-structor"
  },
  "models": {
    "openai": true,
    "anthropic": true
  },
  "clientSupport": {
    "codex": {
      "hooks": true
    },
    "claude": {
      "rules": true,
      "hooks": false,
      "skills": false
    }
  },
  "consumers": [
    {
      "name": "example-app",
      "path": "./example-app",
      "purpose": "Primary application repository",
      "validation": {
        "install": "npm install",
        "lint": "npm run lint",
        "test": "npm test",
        "build": "npm run build"
      }
    }
  ]
}
