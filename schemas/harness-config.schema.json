{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/harness-config.schema.json",
  "title": "Harness Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "output", "models", "consumers"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "harnessRepoName"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "harnessRepoName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai", "anthropic"],
      "properties": {
        "openai": { "type": "boolean" },
        "anthropic": { "type": "boolean" }
      }
    },
    "clientSupport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hooks": { "type": "boolean" }
          }
        },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rules": { "type": "boolean" },
            "hooks": { "const": false },
            "skills": { "const": false }
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "purpose", "validation"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          },
          "purpose": { "type": "string", "minLength": 1 },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "install": { "type": "string" },
              "lint": { "type": "string" },
              "test": { "type": "string" },
              "build": { "type": "string" },
              "health": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
